#!/command/with-contenv bash

set -euo pipefail

# Redirect all future stdout/stderr to s6-log
exec > >(exec s6-log p"open-balena-s3[$$]:" 1 || true) 2>&1

# Change to working directory
cd /usr/src/app || exit 1

export MINIO_ROOT_USER="${S3_MINIO_ACCESS_KEY}"
export MINIO_ROOT_PASSWORD="${S3_MINIO_SECRET_KEY}"

exec /go/bin/silo server --address ":80" --console-address ":43697" /export
